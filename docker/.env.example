# Image tag: latest, a minor version (0.30) or an exact version (0.30.0)
SUPERDBA_TAG=latest

# Login password, at least 12 characters. Left empty, one is generated on the
# first start and printed in `docker compose logs superdba`.
SUPERDBA_WEB_PASSWORD=

# Encrypts saved connection passwords on the data volume, at least 16
# characters. Left empty, a key is generated next to the data. Keep it safe:
# without it the stored credentials cannot be decrypted.
SUPERDBA_SECRET_KEY=

# Local setup (compose.yaml): host port of http://localhost:<port>
SUPERDBA_HTTP_PORT=8080

# Public setup (compose.tls.yaml): the domain Caddy requests a certificate for
SUPERDBA_DOMAIN=

# Grants every browser session host-level operations (plugin management,
# server file access). Only for a single trusted user.
SUPERDBA_ALLOW_HIGH_RISK=false
